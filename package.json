{
  "name": "git-atlas",
  "productName": "GitAtlas",
  "version": "0.1.0",
  "description": "A local-first Git history time machine with a spatial Windows desktop experience.",
  "author": "fqxxzyw",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "build:desktop": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "format": "prettier --write src electron tests scripts",
    "test:ui": "node scripts/smoke.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-git": "^3.30.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "44.9.0",
    "electron-builder": "26.0.12",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "io.github.fqxxzyw.gitatlas",
    "productName": "GitAtlas",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "GitAtlas-Setup-x64.exe"
    },
    "portable": {
      "artifactName": "GitAtlas-Portable-x64.exe"
    }
  }
}
